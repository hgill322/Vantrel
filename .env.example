# SQLite for local dev. Swap to a Postgres connection string for production
# (e.g. "postgresql://user:password@host:5432/vantrel") and update
# prisma/schema.prisma's datasource provider to "postgresql" when you do.
DATABASE_URL="file:./dev.db"

# Random string used to sign the session cookie. Generate with:
# openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-secret"

# Accounts are created with `npm run create-user` (see scripts/create-user.ts),
# not an env var. `npm run prisma:seed` also creates sample staff/landlord
# accounts for local dev.
